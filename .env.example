# Backend API (server reads these — no VITE_ prefix required)
PORT=3001
CORS_ORIGIN=http://localhost:5173

GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Optional: frontend can still call providers directly when backend is unavailable
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_HF_TOKEN=

# Frontend → backend
VITE_API_URL=/api
VITE_USE_BACKEND_AI=true
VITE_WS_PORT=3001
