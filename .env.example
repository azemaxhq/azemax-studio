# =============================================================================
# AZEMAX — Environment Template
# Copy to .env for local development:  cp .env.example .env
# Never commit real secrets.  .env is gitignored.
# =============================================================================

# --------------------------- SERVER-ONLY (never VITE_) -----------------------
# The server reads these via server/config/index.cjs — they never reach the browser.
PORT=3001
NODE_ENV=development
# Comma-separated allowed origins.  For local dev keep localhost.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- AI Providers (server-only) — at least ONE must be set for AI to work ---
# Primary
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fallbacks (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
KILO_API_KEY=
KILO_BASE_URL=https://api.kilocode.ai/v1
# Execution: local compilers/shells are enabled by default in development.
# Production FORBIDS ALLOW_LOCAL_EXECUTION=true and ALLOW_SHELL=true (fatal
# startup error); production uses the Wandbox sandbox instead.
# ALLOW_LOCAL_EXECUTION=false
# ALLOW_SHELL=false

# --- Authentication (Firebase is the ONLY identity provider) ------------------
# There is no guest mode, no anonymous access, and no auth-bypass flag. Every
# product route and API requires a verified Firebase identity. In production the
# server refuses to boot unless Firebase Admin can be configured (fail closed).
#
# Firebase Admin (server-only) — REQUIRED for real sign-in. Without these the
# server boots in development but /api/auth/sync returns 503 and every protected
# API rejects with 401. Get them from the Firebase console:
# Project settings -> Service accounts -> Generate new private key, then copy:
#   FIREBASE_PROJECT_ID   <- project_id
#   FIREBASE_CLIENT_EMAIL <- client_email
#   FIREBASE_PRIVATE_KEY  <- private_key (paste as-is; keep the \n escapes in quotes)
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --------------------------- PUBLIC (VITE_ — visible in browser) ------------
# In development: relative /api goes through Vite proxy → localhost:3001
# In production (Vercel): set to your Render backend URL, e.g. https://azemax-api.onrender.com/api
VITE_API_URL=/api
VITE_USE_BACKEND_AI=true
# The workspace is behind Firebase Authentication. There is no guest mode and
# no VITE_DISABLE_AUTH / VITE_PUBLIC_BETA switch; every product route requires a
# verified Firebase identity.
# VITE_WS_URL=wss://azemax-api.onrender.com
# VITE_WS_PORT is only used in local development
VITE_WS_PORT=3001

# --- Firebase Web SDK (public — safe to expose in the browser) ------------------
# These are NOT secrets (Firebase web config is designed to be public; access is
# enforced by Firebase Security Rules + server-side token verification). Without
# them, Google/email sign-in UI still renders but reports "Firebase Authentication
# is not configured". Copy from Firebase console: Project settings -> Your apps ->
# Web app -> SDK setup and configuration (the firebaseConfig object).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional:
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
