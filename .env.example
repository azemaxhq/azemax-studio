# =============================================================================
# AZEMAX — Environment Template
# Copy to .env for local development:  cp .env.example .env
# Never commit real secrets.  .env is gitignored.
# =============================================================================

# --------------------------- SERVER-ONLY (never VITE_) -----------------------
# The server reads these via server/config/index.cjs — they never reach the browser.
PORT=3001
NODE_ENV=development
# Comma-separated allowed origins.  For local dev keep localhost.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- AI Providers (server-only) — at least ONE must be set for AI to work ---
# Primary
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fallbacks (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
KILO_API_KEY=
KILO_BASE_URL=https://api.kilocode.ai/v1
# Execution: disable local code execution on ephemeral public hosts
# Set to "true" to allow local execution in production (NOT recommended for Render free tier)
# ALLOW_LOCAL_EXECUTION=false

# --- Public beta (anonymous workspace, default ON) -------------------------------
# PUBLIC_BETA=false restores a hard login wall (workspace requires sign-in).
# When enabled (default), visitors use the editor without an account: files
# persist locally in the browser; server AI (/api/ai/*) and code execution
# (/api/execute, /api/runtimes, WS code sessions) accept anonymous requests
# attributed to the client IP under tighter daily quotas (AI_ANON_REQUESTS_PER_DAY,
# EXEC_ANON_REQUESTS_PER_DAY). Server projects (/api/projects) and admin
# endpoints STAY login-required — anonymous users can never touch private data.
# Unlike DISABLE_AUTH this creates NO shared server identity.
# PUBLIC_BETA=false
# AI_ANON_REQUESTS_PER_DAY=50
# EXEC_ANON_REQUESTS_PER_DAY=60

# --- Login bypass (reversible) --------------------------------------------------
# DISABLE_AUTH=true skips the email/password gate with a fixed local user.
# Auth code + real accounts in data/azemax.db are untouched — unset to restore login.
# Local dev: just set DISABLE_AUTH=true.
# Public beta (production): ALSO set ALLOW_PUBLIC_BYPASS=true, otherwise the
# server refuses to boot. Everyone shares ONE identity — see warning in
# server/config/env.cjs. Unset both to restore login.
# DISABLE_AUTH=false
# ALLOW_PUBLIC_BYPASS=false

# --------------------------- PUBLIC (VITE_ — visible in browser) ------------
# In development: relative /api goes through Vite proxy → localhost:3001
# In production (Vercel): set to your Render backend URL, e.g. https://azemax-api.onrender.com/api
VITE_API_URL=/api
VITE_USE_BACKEND_AI=true
# VITE_PUBLIC_BETA=false restores the hard login wall (default is open beta:
# visitors reach /app with no account; sign-in stays optional).
# Build-time flag: set it in the Vercel environment AND redeploy.
# VITE_PUBLIC_BETA=true
# VITE_DISABLE_AUTH=true removes the login page entirely (legacy bypass,
# shared local-dev identity — prefer VITE_PUBLIC_BETA for public deploys).
# VITE_WS_URL=wss://azemax-api.onrender.com
# VITE_WS_PORT is only used in local development
VITE_WS_PORT=3001
