# Backend API (server reads these — no VITE_ prefix required)
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Default AI provider — NVIDIA Nemotron via the NVIDIA OpenAI-compatible API.
# Requests route frontend → backend → NVIDIA, so the key lives only on the server.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Legacy fallback providers (used by the backend only when the NVIDIA key/model fails)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Optional: frontend can still call providers directly when backend is unavailable
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_HF_TOKEN=

# Frontend → backend
VITE_API_URL=/api
VITE_USE_BACKEND_AI=true
VITE_WS_PORT=3001
