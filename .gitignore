# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Security - Sensitive items (never commit secrets)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret
secrets/
.aws/
.gcp/
.azure/

# IndexNow verification key file (generated at build time, never committed)
public/indexnow-key.txt
.indexnow-state.json

# Server data (ephemeral on Render free tier)
data/workspaces/*.json
data/workspaces/*.log
!data/workspaces/.gitkeep
# SQLite databases (contain user accounts, sessions, projects — NEVER commit)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Compiled test binaries (build artifacts, never commit)
test_cpp/main

# Test / build reports (regenerated locally and in CI; never commit)
test-results/
playwright-report/
lighthouse-*.json
# Local server data (SQLite + workspace files — contain user data, never commit)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/workspaces/
!data/workspaces/.gitkeep

# Reports
reports/
