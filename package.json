{
  "name": "azemax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0 <25"
  },
  "scripts": {
    "predev": "node scripts/ensure-backend.cjs",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "wait-on -t 10000 http-get://127.0.0.1:3001/api/health && vite",
    "server": "node --watch server/index.cjs",
    "start": "node server/index.cjs",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=1 tsc -b && vite build",
    "lint": "eslint .",
    "lint:server": "eslint server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "db:backup": "node scripts/db-backup.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.29.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10"
  }
}
